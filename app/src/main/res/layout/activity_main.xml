<?xml version="1.0" encoding="utf-8"?>
<!-- el layout el racine: ConstraintLayout t7out 3al ecran el kol -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- LinearLayout 3amoudi, fih el formulaire kemel (el champs w el bouton) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="24dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <!-- titre mta3 el application: gras w italique, fil west, taille 24 -->
        <TextView
            android:id="@+id/txt_titre_ag"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="@string/titre_application"
            android:textSize="24sp"
            android:textStyle="bold|italic"
            tools:ignore="TextSizeCheck" />

        <!-- label mta3 el champ: esm el voyageur -->
        <TextView
            android:id="@+id/txt_nom_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_nom"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- el champ elli yekteb fih el voyageur esmou (texte 3adi) m3a hint -->
        <EditText
            android:id="@+id/edt_nom_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:ems="10"
            android:hint="@string/hint_nom"
            android:inputType="text"
            android:minHeight="48dp"
            tools:ignore="VisualLintTextFieldSize" />

        <!-- label mta3 el champ: 3am el wileda (annee de naissance) -->
        <TextView
            android:id="@+id/txt_naissance_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_naissance"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- champ mta3 3am el wileda: ar9am bark (exemple 1990) -->
        <EditText
            android:id="@+id/edt_naissance_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:ems="10"
            android:hint="@string/edt_naissance_ag"
            android:inputType="number"
            android:minHeight="48dp"
            android:textColor="#000000"
            tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

        <!-- label mta3 el champ: 3am el destination (annee de destination) -->
        <TextView
            android:id="@+id/txt_destination_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_destination"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- champ mta3 3am el destination: ar9am bark (exemple 2050) -->
        <EditText
            android:id="@+id/edt_destination_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:ems="10"
            android:hint="@string/edt_destination_ag"
            android:inputType="number"
            android:minHeight="48dp"
            android:textColor="#000000"
            tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />

        <!-- label mta3 el champ: sbeb el safra (motif) -->
        <TextView
            android:id="@+id/txt_motif_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_motif"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- liste deroulante bech te5tar menha sbeb el safra (Tourisme, Modification du passe, Fuite) -->
        <!-- el 9yam mawjoudin fil array motifs_voyage fi west strings.xml -->
        <Spinner
            android:id="@+id/sp_motif_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/motifs_voyage"
            android:minHeight="48dp" />

        <!-- bouton "Inspecter le profil": ki tenzel 3lih, tab3eth el donnees lel activite 2 b Intent explicite -->
        <Button
            android:id="@+id/btn_inspecter_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_inspecter"
            tools:ignore="VisualLintButtonSize" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>