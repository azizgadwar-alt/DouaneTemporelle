<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="24dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <TextView
            android:id="@+id/txt_titre_ag"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="@string/titre_application"
            android:textSize="24sp"
            android:textStyle="bold|italic"
            tools:ignore="TextSizeCheck" />

        <TextView
            android:id="@+id/txt_nom_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_nom"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_nom_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:ems="10"
            android:hint="@string/hint_nom"
            android:inputType="text"
            android:minHeight="48dp"
            tools:ignore="VisualLintTextFieldSize" />

        <TextView
            android:id="@+id/txt_naissance_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_naissance"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_naissance_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:ems="10"
            android:hint="@string/edt_naissance_ag"
            android:inputType="number"
            android:minHeight="48dp"
            android:textColor="#000000"
            tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

        <TextView
            android:id="@+id/txt_destination_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_destination"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_destination_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:ems="10"
            android:hint="@string/edt_destination_ag"
            android:inputType="number"
            android:minHeight="48dp"
            android:textColor="#000000"
            tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />

        <TextView
            android:id="@+id/txt_motif_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_motif"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_motif_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/motifs_voyage"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btn_inspecter_ag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_inspecter"
            tools:ignore="VisualLintButtonSize" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>